# Optional source credentials. The submitted clean run used public endpoints;
# GITHUB_TOKEN refreshes repository stars directly through GraphQL.
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
PRODUCT_HUNT_TOKEN=

# Ordered OpenAI-compatible fallback chain. A provider is enabled only when all
# three values for that tier are present. No provider key is committed.
ENABLE_LLM_ENRICHMENT=true
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_BASE_URL=
PRIMARY_LLM_MODEL=
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_BASE_URL=
SECONDARY_LLM_MODEL=
TERTIARY_LLM_API_KEY=
TERTIARY_LLM_BASE_URL=
TERTIARY_LLM_MODEL=
LLM_MAX_CALLS_PER_RUN=200
LLM_RETRIES_PER_PROVIDER=2

DATABASE_URL=sqlite:///data/frontier.db
RAW_STORE_PATH=data/raw
CANONICAL_ENTITIES_PATH=configs/canonical_entities.json
WRITE_BATCH_SIZE=200
DEFAULT_HOST_CONCURRENCY=4
MAX_ATTEMPTS=4
REQUEST_TIMEOUT_SECONDS=45
HTTP_USER_AGENT=frontier-ingest/1.0 interview-assessment
